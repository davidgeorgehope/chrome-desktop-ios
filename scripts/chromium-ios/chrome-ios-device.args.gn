target_os = "ios"
target_environment = "device"
target_cpu = "arm64"
use_blink = true
is_debug = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
ios_content_shell_bundle_identifier = "com.davidhope.deskbrowser.shell"
ios_chromium_bundle_id = "com.davidhope.deskbrowser.blink"
# Signed manually afterwards (scripts/chromium-ios/sign-chrome-ios-device.sh)
# with team 4P2629648N; avoids find_signing_identity.py / security CLI.
ios_enable_code_signing = false
# share extension kept on: disabling every extension trips an unused-var gn error
ios_enable_share_extension = true
ios_enable_extended_share_extension = false
ios_enable_open_extension = false
ios_enable_credential_provider_extension = false
ios_enable_intents_extension = false
ios_enable_widget_kit_extension = false
ios_enable_push_notification_service_extension = false

# Jitless Wasm interpreter (DrumBrake) fallback.
v8_enable_drumbrake = true
