#cloud-config
hostname: cratebench
users:
  - name: bench
    gecos: bench
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: "<random SHA-512 hash, regenerate>"
    ssh_authorized_keys:
      - ssh-ed25519 <temp key, deleted> crate-bench
ssh_pwauth: false
timezone: America/New_York
resize_rootfs: true
write_files:
  - path: /usr/local/bin/metrics_httpd.py
    permissions: '0755'
    encoding: b64
    content: 
  - path: /usr/local/bin/bench-session.sh
    permissions: '0755'
    encoding: b64
    content: 
  - path: /usr/local/share/interactive-metrics/index.html
    permissions: '0644'
    encoding: b64
    content: 
  - path: /usr/local/share/interactive-metrics/warm.html
    permissions: '0644'
    encoding: b64
    content: 
  - path: /usr/local/etc/firefox-user.js
    permissions: '0644'
    encoding: b64
    content: 
  - path: /usr/local/etc/chromium-flags
    permissions: '0644'
    encoding: b64
    content: 
  - path: /etc/udev/rules.d/99-bench-ttyAMA0.rules
    content: |
      KERNEL=="ttyAMA0", MODE="0666"
  - path: /etc/xdg/autostart/bench-session.desktop
    content: |
      [Desktop Entry]
      Type=Application
      Name=bench-session
      Exec=/usr/local/bin/bench-session.sh
      X-GNOME-Autostart-enabled=true
runcmd:
  - [ chmod, '0666', /dev/ttyAMA0 ]
