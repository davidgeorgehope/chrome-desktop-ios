#!/bin/sh
# busybox httpd CGI: browser posts a marker line; echo it to the UML serial.
echo "Content-Type: text/plain"
echo
if [ "${REQUEST_METHOD:-GET}" = POST ]; then
  n=${CONTENT_LENGTH:-0}
  body=""
  if [ "$n" -gt 0 ] 2>/dev/null; then
    body=$(dd bs=1 count="$n" 2>/dev/null)
  else
    body=$(cat)
  fi
  echo "$body" | tee -a /tmp/interactive-metrics.log >/dev/ttyS0
  echo ok
else
  echo "ready"
fi
