diff --git a/GuestHost/Config/Signing.local.xcconfig.example b/GuestHost/Config/Signing.local.xcconfig.example
index 028d0f6..6872957 100644
--- a/GuestHost/Config/Signing.local.xcconfig.example
+++ b/GuestHost/Config/Signing.local.xcconfig.example
@@ -3,5 +3,13 @@
 // Copy to Signing.local.xcconfig, which Git ignores, and name your Apple
 // Developer team: the 10-character Team ID shown under Membership details.
 // Each checkout or worktree that builds for a device needs its own copy.
+//
+// Optionally override the official bundle identifiers when you cannot sign
+// com.imxieyi.Kernarium (for example a personal team's unique App ID):
+//
+// KERNARIUM_BUNDLE_IDENTIFIER = com.example.kernarium
+// KERNARIUM_TESTS_BUNDLE_IDENTIFIER = com.example.kernarium.tests
+// KERNARIUM_UITESTS_BUNDLE_IDENTIFIER = com.example.kernarium.uitests
+// KERNARIUM_AUTOMATION_BUNDLE_IDENTIFIER = com.example.kernarium.automation
 
 DEVELOPMENT_TEAM = ABCDE12345
diff --git a/GuestHost/Config/Signing.xcconfig b/GuestHost/Config/Signing.xcconfig
index 9f94727..0aa7cc3 100644
--- a/GuestHost/Config/Signing.xcconfig
+++ b/GuestHost/Config/Signing.xcconfig
@@ -5,7 +5,16 @@
 // Signing.local.xcconfig beside this file (see Signing.local.xcconfig.example).
 // With no team, builds for the iOS Simulator work unsigned and a build for a
 // device stops with Xcode's "requires a development team" error.
+//
+// Bundle identifiers default to the official product. Override them in
+// Signing.local.xcconfig (for example com.davidhope.kernarium) when the
+// official ID cannot be signed by your team.
 
 DEVELOPMENT_TEAM =
 
+KERNARIUM_BUNDLE_IDENTIFIER = com.imxieyi.Kernarium
+KERNARIUM_TESTS_BUNDLE_IDENTIFIER = com.imxieyi.KernariumTests
+KERNARIUM_UITESTS_BUNDLE_IDENTIFIER = com.imxieyi.KernariumUITests
+KERNARIUM_AUTOMATION_BUNDLE_IDENTIFIER = com.imxieyi.KernariumAutomation
+
 #include? "Signing.local.xcconfig"
diff --git a/Kernarium/scripts/run-ios-mac.sh b/Kernarium/scripts/run-ios-mac.sh
index 7a7b8e6..3c01b17 100755
--- a/Kernarium/scripts/run-ios-mac.sh
+++ b/Kernarium/scripts/run-ios-mac.sh
@@ -22,7 +22,15 @@ ROOTFS=
 # shellcheck disable=SC1091
 . "$ROOT_DIR/kernel/mainline-6.18/artifacts/accepted-4k.env"
 ARTIFACT=${UML_MAINLINE_618_KERNEL_ARTIFACT_DIR:-"$ROOT_DIR/.build/kernel/artifacts/$UML_KERNEL_ARTIFACT_DIRECTORY_NAME"}
-BUNDLE_ID=com.imxieyi.Kernarium
+# Official default; override with KERNARIUM_BUNDLE_IDENTIFIER or Signing.local.xcconfig.
+BUNDLE_ID=${KERNARIUM_BUNDLE_IDENTIFIER:-}
+if [ -z "$BUNDLE_ID" ]; then
+	_sign_local="$ROOT_DIR/GuestHost/Config/Signing.local.xcconfig"
+	if [ -f "$_sign_local" ]; then
+		BUNDLE_ID=$(awk -F " *= *" '/^KERNARIUM_BUNDLE_IDENTIFIER[ \t]*=/{print $2; exit}' "$_sign_local")
+	fi
+fi
+BUNDLE_ID=${BUNDLE_ID:-com.imxieyi.Kernarium}
 DERIVED_DATA="$ROOT_DIR/.build/kernarium-xcode-derived"
 INITRAMFS_TOOL="$ROOT_DIR/.build/presets/macos-integration/bin/uml-initramfs"
 DESTINATION='platform=macOS,variant=Designed for iPad'
@@ -173,8 +181,12 @@ fi
 
 CDPATH= cd -- "$ROOT_DIR"
 if [ "$SKIP_BUILD" -eq 0 ]; then
+	# Local bakeoff: Designed for iPad is an ios-device binary on macOS.
+	# Turn off the iPhone debugger JIT region so MAP_JIT + allow-jit is
+	# used. A physical iPhone install is still out of scope.
 	cmake --preset "$PRESET" \
-		-DUML_MAINLINE_618_KERNEL_ARTIFACT_DIR="$ARTIFACT"
+		-DUML_MAINLINE_618_KERNEL_ARTIFACT_DIR="$ARTIFACT" \
+		-DUML_IOS_DEBUGGER_JIT=OFF
 	cmake --build --preset "$PRESET" --parallel "$JOBS"
 	if [ -n "$ANDROID_PRESET" ]; then
 		cmake --preset "$ANDROID_PRESET"
