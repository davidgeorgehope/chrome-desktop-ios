+    /// Optional Documents log of raw guest serial, enabled by KERNARIUM_SERIAL_LOG
+    /// (a basename only). Designed-for-iPad has no simctl console-pty.
+    private var serialLog: FileHandle?
+
+    private func openSerialLogIfRequested() {
+        let env = ProcessInfo.processInfo.environment
+        guard let name = env["KERNARIUM_SERIAL_LOG"], !name.isEmpty else { return }
+        guard !name.contains("/"), name != "." , name != "..", !name.hasPrefix(".") else {
+            print("Kernarium: ignoring invalid KERNARIUM_SERIAL_LOG")
+            return
+        }
+        guard let documents = FileManager.default.urls(
+            for: .documentDirectory, in: .userDomainMask
+        ).first else { return }
+        let url = documents.appendingPathComponent(name)
+        FileManager.default.createFile(atPath: url.path, contents: nil)
+        serialLog = FileHandle(forWritingAtPath: url.path)
+        print("Kernarium: serial log \(name)")
+    }
+
+    private func writeSerialLog(_ data: Data) {
+        serialLog?.write(data)
+    }
+
