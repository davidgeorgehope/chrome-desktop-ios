+    private static func sendBenchesScript() {
+        // Run on the serial console after the desktop is up so DESKTOP_READY
+        // is not delayed. Prefer tools already in the desktop image.
+        let script = """
+        echo
+        echo ===BENCH_START===
+        date
+        echo uptime: $(cat /proc/uptime)
+        echo "======== uname ========"
+        uname -a
+        echo "======== os_release ========"
+        sed -n '1,5p' /etc/os-release
+        echo "======== sh_loop ========"
+        time sh -c 'i=0; while [ $i -lt 20000 ]; do i=$((i+1)); done'
+        echo "======== dd_null ========"
+        dd if=/dev/zero of=/dev/null bs=1M count=32
+        echo "======== dd_write32 ========"
+        dd if=/dev/zero of=/tmp/32m bs=1M count=32
+        echo "======== sha256_32m ========"
+        time sha256sum /tmp/32m
+        echo "======== openssl_speed ========"
+        if ! command -v openssl >/dev/null 2>&1; then
+          echo "======== apk_add_openssl ========"
+          time apk add --no-cache openssl
+          echo "APK_OPENSSL_EXIT:$?"
+        fi
+        if command -v openssl >/dev/null 2>&1; then
+          openssl version
+          openssl speed -seconds 3 -evp sha256 aes-256-cbc
+        else
+          echo "OPENSSL_MISSING"
+        fi
+        echo ===BENCH_DONE===
+        date
+        echo uptime: $(cat /proc/uptime)
+
+        """
+        // Enter, then the script, then a trailing newline.
+        SerialConsoleController.sendToGuest(Data("\n".utf8))
+        Thread.sleep(forTimeInterval: 0.5)
+        SerialConsoleController.sendToGuest(Data(script.utf8))
+    }
