           [ -d "$SRC" ] || { echo "error: no StikJIT: run Scripts/fetch-stikjit.sh"; exit 1; }
           DEST="$TARGET_BUILD_DIR/$FRAMEWORKS_FOLDER_PATH"
           mkdir -p "$DEST"
-          rsync -a --delete "$SRC" "$DEST/"
+          # Leave out Headers/Modules: the app's Embed App Extensions copy
