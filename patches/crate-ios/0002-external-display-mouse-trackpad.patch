diff --git a/Sources/Crate/Engine/PointerLock.swift b/Sources/Crate/Engine/PointerLock.swift
new file mode 100644
index 0000000..96f983f
--- /dev/null
+++ b/Sources/Crate/Engine/PointerLock.swift
@@ -0,0 +1,48 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+import SwiftUI
+import UIKit
+
+/// Asks iPadOS to hide its pointer and hand the mouse to the app. It only
+/// does so when the app fills the screen; an iPhone never locks the pointer,
+/// but the request is still made so a Designed-for-iPad or iPad session can.
+enum PointerLock {
+    private static var wanted = false
+
+    static func set(wanted: Bool) {
+        self.wanted = wanted
+        for scene in UIApplication.shared.connectedScenes.compactMap({ $0 as? UIWindowScene }) {
+            for window in scene.windows {
+                window.rootViewController?.setNeedsUpdateOfPrefersPointerLocked()
+                window.rootViewController?.children.forEach { $0.setNeedsUpdateOfPrefersPointerLocked() }
+            }
+        }
+    }
+
+    static var isWanted: Bool { wanted }
+}
+
+/// A SwiftUI host whose view controller answers `prefersPointerLocked`.
+struct PointerLockHost: UIViewControllerRepresentable {
+    func makeUIViewController(context: Context) -> Controller { Controller() }
+    func updateUIViewController(_ controller: Controller, context: Context) {
+        controller.setNeedsUpdateOfPrefersPointerLocked()
+    }
+
+    final class Controller: UIViewController {
+        override var prefersPointerLocked: Bool { PointerLock.isWanted }
+
+        override func viewDidLoad() {
+            super.viewDidLoad()
+            view.isUserInteractionEnabled = false
+            view.backgroundColor = .clear
+        }
+
+        override func viewDidAppear(_ animated: Bool) {
+            super.viewDidAppear(animated)
+            setNeedsUpdateOfPrefersPointerLocked()
+        }
+    }
+}
diff --git a/Sources/Crate/Engine/TrackpadView.swift b/Sources/Crate/Engine/TrackpadView.swift
new file mode 100644
index 0000000..d3975ea
--- /dev/null
+++ b/Sources/Crate/Engine/TrackpadView.swift
@@ -0,0 +1,157 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+import SwiftUI
+import UIKit
+
+/// The phone's screen as a trackpad while the desktop is on an external
+/// monitor: a finger moves the guest pointer, a tap clicks, a two-finger tap
+/// is a right click, a held finger drags, and two fingers scroll. A hardware
+/// mouse, if one is connected, is left to HardwareMouse (its touches are
+/// ignored here).
+struct TrackpadView: UIViewRepresentable {
+    let pointer: GuestPointer
+
+    func makeUIView(context: Context) -> Surface { Surface(pointer: pointer) }
+    func updateUIView(_ view: Surface, context: Context) { view.pointer = pointer }
+
+    final class Surface: UIView, UIPointerInteractionDelegate {
+        var pointer: GuestPointer
+        private static let tapTime: TimeInterval = 0.3
+        private static let holdTime: TimeInterval = 0.4
+        private static let tapDistance: CGFloat = 10
+        private static let notch: CGFloat = 20
+
+        private var started = Date()
+        private var travelled: CGFloat = 0
+        private var mostFingers = 0
+        private var holding = false
+        private var holdTimer: Timer?
+        private var scrollCarry = CGPoint.zero
+        private let buzz = UIImpactFeedbackGenerator(style: .medium)
+
+        init(pointer: GuestPointer) {
+            self.pointer = pointer
+            super.init(frame: .zero)
+            isMultipleTouchEnabled = true
+            backgroundColor = .clear
+            addInteraction(UIPointerInteraction(delegate: self))
+        }
+
+        @available(*, unavailable)
+        required init?(coder: NSCoder) { fatalError() }
+
+        func pointerInteraction(_ interaction: UIPointerInteraction, styleFor region: UIPointerRegion) -> UIPointerStyle? {
+            .hidden()
+        }
+
+        override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent?) {
+            let fingers = touches.filter { $0.type != .indirectPointer }
+            guard !fingers.isEmpty else { return }
+            if event?.allTouches?.filter({ $0.type != .indirectPointer && $0.phase != .cancelled && $0.phase != .ended }).count == fingers.count {
+                started = Date()
+                travelled = 0
+                mostFingers = 0
+                scrollCarry = .zero
+                buzz.prepare()
+            }
+            mostFingers = max(mostFingers, liveFingers(in: event))
+            if mostFingers >= 2 {
+                cancelHold()
+                if holding {
+                    holding = false
+                    pointer.press(1, down: false)
+                }
+            } else {
+                armHold()
+            }
+        }
+
+        override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent?) {
+            let fingers = touches.filter { $0.type != .indirectPointer }
+            guard !fingers.isEmpty else { return }
+            let count = liveFingers(in: event)
+            if count >= 2 {
+                // Two-finger scroll: the content follows the fingers.
+                var moved = CGPoint.zero
+                for touch in fingers {
+                    let now = touch.location(in: self)
+                    let before = touch.previousLocation(in: self)
+                    travelled += abs(now.x - before.x) + abs(now.y - before.y)
+                    moved.x += now.x - before.x
+                    moved.y += now.y - before.y
+                }
+                let n = CGFloat(max(fingers.count, 1))
+                scrollCarry.x += moved.x / n
+                scrollCarry.y += moved.y / n
+                let dx = Int32(-scrollCarry.x / Self.notch)
+                let dy = Int32(-scrollCarry.y / Self.notch)
+                if dx != 0 || dy != 0 {
+                    pointer.scroll(dx: dx, dy: dy)
+                    scrollCarry.x += CGFloat(dx) * Self.notch
+                    scrollCarry.y += CGFloat(dy) * Self.notch
+                }
+                cancelHold()
+                return
+            }
+            guard let touch = fingers.first else { return }
+            let now = touch.location(in: self)
+            let before = touch.previousLocation(in: self)
+            let dx = now.x - before.x
+            let dy = now.y - before.y
+            travelled += abs(dx) + abs(dy)
+            pointer.move(dx: Double(dx), dy: Double(dy))
+            if travelled >= Self.tapDistance && !holding { cancelHold() }
+        }
+
+        override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent?) { lift(touches, event: event) }
+        override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent?) { lift(touches, event: event) }
+
+        private func lift(_ touches: Set<UITouch>, event: UIEvent?) {
+            let fingers = touches.filter { $0.type != .indirectPointer }
+            guard !fingers.isEmpty else { return }
+            if liveFingers(in: event) > 0 { return }
+            cancelHold()
+            let quick = Date().timeIntervalSince(started) < Self.tapTime
+            let still = travelled < Self.tapDistance
+            if holding {
+                holding = false
+                pointer.press(1, down: false)
+            } else if quick && still {
+                if mostFingers <= 1 {
+                    pointer.click(1)
+                    buzz.impactOccurred()
+                } else if mostFingers == 2 {
+                    pointer.click(2)
+                    buzz.impactOccurred()
+                }
+            }
+        }
+
+        private func liveFingers(in event: UIEvent?) -> Int {
+            event?.allTouches?.filter { $0.type != .indirectPointer && $0.phase != .ended && $0.phase != .cancelled }.count ?? 0
+        }
+
+        /// A finger that stays put presses the left button, so moving it drags.
+        private func armHold() {
+            cancelHold()
+            let timer = Timer(timeInterval: Self.holdTime, repeats: false) { [weak self] _ in
+                guard let self else { return }
+                Task { @MainActor in
+                    guard self.travelled < Self.tapDistance else { return }
+                    self.holding = true
+                    self.pointer.press(1, down: true)
+                    self.buzz.impactOccurred()
+                }
+            }
+            RunLoop.main.add(timer, forMode: .common)
+            holdTimer = timer
+        }
+
+        private func cancelHold() {
+            holdTimer?.invalidate()
+            holdTimer = nil
+        }
+    }
+}
