diff --git a/Sources/Crate/Engine/ExternalDisplay.swift b/Sources/Crate/Engine/ExternalDisplay.swift
new file mode 100644
index 0000000..d216797
--- /dev/null
+++ b/Sources/Crate/Engine/ExternalDisplay.swift
@@ -0,0 +1,315 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+import Observation
+import SwiftUI
+import UIKit
+
+/// One external display the coordinator can put the desktop on.
+@MainActor
+protocol ExternalScreen: AnyObject {
+    var id: UUID { get }
+    func showDesktop(bridge: DisplayBridge)
+    func hideDesktop()
+    var nativePixels: CGSize { get }
+}
+
+/// Tracks connected monitors and, while a VM is running, puts the guest
+/// desktop on them at the monitor's own size (up to 3840×2160, the engine's
+/// per-side limit is 4095). Unplugging offers the phone's size again. On
+/// iOS 17–26 the display scene is delivered to ExternalDisplaySceneDelegate
+/// because Info.plist declares that role; without the entry iOS only mirrors
+/// the phone and the app hears nothing.
+@MainActor
+@Observable
+final class ExternalDisplayCoordinator {
+    static let shared = ExternalDisplayCoordinator()
+
+    /// A monitor is connected and the running VM is being shown on it.
+    private(set) var isPresenting = false
+    /// A monitor is connected, whether or not a VM is using it.
+    private(set) var isConnected = false
+    private(set) var pointer: GuestPointer?
+
+    private var screens: [UUID: ExternalScreen] = [:]
+    private var bridge: DisplayBridge?
+    private var sessionActive = false
+
+    func sessionDidBegin(display: DisplayBridge) {
+        sessionDidEnd()
+        bridge = display
+        pointer = GuestPointer(bridge: display)
+        sessionActive = true
+        HardwareMouse.shared.start(pointer: pointer!)
+        presentIfPossible()
+    }
+
+    func sessionDidEnd() {
+        HardwareMouse.shared.stop()
+        if sessionActive {
+            for screen in screens.values { screen.hideDesktop() }
+        }
+        sessionActive = false
+        isPresenting = false
+        bridge?.locksToExternal = false
+        pointer = nil
+        bridge = nil
+    }
+
+    func attach(_ screen: ExternalScreen) {
+        screens[screen.id] = screen
+        isConnected = !screens.isEmpty
+        AppLog.write("external display: connected \(Int(screen.nativePixels.width))x\(Int(screen.nativePixels.height))")
+        presentIfPossible()
+    }
+
+    func screenDidChangeSize(_ screen: ExternalScreen) {
+        AppLog.write("external display: size now \(Int(screen.nativePixels.width))x\(Int(screen.nativePixels.height))")
+        if sessionActive { presentIfPossible() }
+    }
+
+    func detach(_ screen: ExternalScreen) {
+        screen.hideDesktop()
+        screens.removeValue(forKey: screen.id)
+        isConnected = !screens.isEmpty
+        AppLog.write("external display: disconnected")
+        if sessionActive, let bridge, screens.isEmpty {
+            isPresenting = false
+            bridge.locksToExternal = false
+            AppLog.write("external display: guest size follows the phone again")
+        } else {
+            presentIfPossible()
+        }
+    }
+
+    private func presentIfPossible() {
+        guard sessionActive, let bridge, let pointer else { return }
+        let active = screens.values.sorted { $0.id.uuidString < $1.id.uuidString }
+        guard let first = active.first else { return }
+        let pixels = first.nativePixels
+        bridge.fitPixels(pixels)
+        for screen in active { screen.showDesktop(bridge: bridge) }
+        if !isPresenting {
+            isPresenting = true
+            AppLog.write("external display: desktop on the monitor")
+        }
+        // Keep the mouse and trackpad talking to the same pointer after a
+        // reconnect (sessionDidBegin already started HardwareMouse).
+        _ = pointer
+    }
+}
+
+/// The UIKit scene for `UIWindowSceneSessionRoleExternalDisplayNonInteractive`.
+/// The class name is the one Info.plist looks up; it is not renamed with @objc.
+final class ExternalDisplaySceneDelegate: UIResponder, UIWindowSceneDelegate, ExternalScreen {
+    let id = UUID()
+    var window: UIWindow?
+    private var windowScene: UIWindowScene?
+    private var outputID = UUID()
+
+    var nativePixels: CGSize {
+        guard let scene = windowScene else { return .zero }
+        // The window's point size times the screen scale is what is actually
+        // drawn. Simulator TVOut can keep a stale currentMode (720×480) after
+        // I/O > External Displays has changed the framebuffer to 1920×1080.
+        let scale = max(scene.screen.scale, 1)
+        let fromScene = CGSize(width: scene.coordinateSpace.bounds.width * scale,
+                               height: scene.coordinateSpace.bounds.height * scale)
+        if let mode = scene.screen.currentMode, mode.size.width >= 16, mode.size.height >= 16 {
+            if mode.size.width * mode.size.height >= fromScene.width * fromScene.height {
+                return mode.size
+            }
+        }
+        if fromScene.width >= 16, fromScene.height >= 16 { return fromScene }
+        return scene.screen.nativeBounds.size
+    }
+
+    func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {
+        guard let scene = scene as? UIWindowScene else { return }
+        windowScene = scene
+        logGeometry("connecting")
+        showIdle()
+        ExternalDisplayCoordinator.shared.attach(self)
+    }
+
+    func windowScene(_ windowScene: UIWindowScene, didUpdate previousCoordinateSpace: UICoordinateSpace, interfaceOrientation previousInterfaceOrientation: UIInterfaceOrientation, traitCollection previousTraitCollection: UITraitCollection) {
+        self.windowScene = windowScene
+        logGeometry("updated")
+        ExternalDisplayCoordinator.shared.screenDidChangeSize(self)
+    }
+
+    func sceneDidDisconnect(_ scene: UIScene) {
+        ExternalDisplayCoordinator.shared.detach(self)
+        windowScene = nil
+    }
+
+    private func logGeometry(_ reason: String) {
+        let offered = nativePixels
+        let mode = windowScene?.screen.currentMode
+        AppLog.write("external display: \(reason) offered \(Int(offered.width))x\(Int(offered.height)) px, "
+                     + "mode \(mode.map { "\(Int($0.size.width))x\(Int($0.size.height))" } ?? "unknown"), "
+                     + "scene \(Int(windowScene?.coordinateSpace.bounds.width ?? 0))x\(Int(windowScene?.coordinateSpace.bounds.height ?? 0))")
+    }
+
+    /// A full-screen window so the monitor is ours (not a mirror) even
+    /// before a VM is running.
+    func showIdle() {
+        guard let windowScene else { return }
+        let window = self.window ?? UIWindow(windowScene: windowScene)
+        let host = ExternalDisplayHost()
+        let label = UILabel()
+        label.text = "Start a machine to show the desktop here."
+        label.textColor = .lightGray
+        label.font = .preferredFont(forTextStyle: .title2)
+        label.textAlignment = .center
+        label.numberOfLines = 0
+        label.translatesAutoresizingMaskIntoConstraints = false
+        host.view.addSubview(label)
+        NSLayoutConstraint.activate([
+            label.centerXAnchor.constraint(equalTo: host.view.centerXAnchor),
+            label.centerYAnchor.constraint(equalTo: host.view.centerYAnchor),
+            label.leadingAnchor.constraint(greaterThanOrEqualTo: host.view.leadingAnchor, constant: 40),
+            label.trailingAnchor.constraint(lessThanOrEqualTo: host.view.trailingAnchor, constant: -40),
+        ])
+        window.rootViewController = host
+        window.backgroundColor = .black
+        window.isHidden = false
+        self.window = window
+    }
+
+    func showDesktop(bridge: DisplayBridge) {
+        guard let windowScene else { return }
+        if window != nil { hideDesktop() }
+        let window = UIWindow(windowScene: windowScene)
+        let host = ExternalDisplayHost()
+        let view = ExternalScreenView(bridge: bridge, outputID: outputID)
+        view.frame = windowScene.coordinateSpace.bounds
+        view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        host.view.addSubview(view)
+        host.view.backgroundColor = .black
+        window.rootViewController = host
+        window.backgroundColor = .black
+        window.isHidden = false
+        self.window = window
+    }
+
+    func hideDesktop() {
+        guard let window else { return }
+        window.rootViewController = nil
+        window.isHidden = true
+        self.window = nil
+    }
+}
+
+/// Root of the external window, so pointer lock can be asked of a real
+/// view controller, and the picture is not letterboxed by safe-area insets.
+final class ExternalDisplayHost: UIViewController {
+    override var prefersPointerLocked: Bool { PointerLock.isWanted }
+    override var prefersHomeIndicatorAutoHidden: Bool { true }
+    override var prefersStatusBarHidden: Bool { true }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .black
+        view.insetsLayoutMarginsFromSafeArea = false
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        setNeedsUpdateOfPrefersPointerLocked()
+    }
+}
+
+/// The guest's frames, scaled to fit the monitor, with no chrome.
+final class ExternalScreenView: UIView {
+    private let bridge: DisplayBridge
+    private let outputID: UUID
+    private let picture = CALayer()
+    private var imageSize = CGSize.zero
+
+    init(bridge: DisplayBridge, outputID: UUID) {
+        self.bridge = bridge
+        self.outputID = outputID
+        super.init(frame: .zero)
+        backgroundColor = .black
+        isUserInteractionEnabled = false
+        picture.magnificationFilter = .linear
+        layer.addSublayer(picture)
+        bridge.addOutput(outputID) { [weak self] image in
+            self?.show(image)
+        }
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) { fatalError() }
+
+    deinit {
+        // addOutput/removeOutput are main-actor; teardown happens on the
+        // main thread with the window.
+    }
+
+    override func willMove(toWindow newWindow: UIWindow?) {
+        super.willMove(toWindow: newWindow)
+        if newWindow == nil {
+            bridge.removeOutput(outputID)
+        }
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        picture.frame = screenRect
+        CATransaction.commit()
+    }
+
+    private func show(_ image: CGImage) {
+        let size = CGSize(width: image.width, height: image.height)
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        picture.contents = image
+        if size != imageSize {
+            imageSize = size
+            picture.frame = screenRect
+        }
+        CATransaction.commit()
+    }
+
+    private var screenRect: CGRect {
+        guard imageSize.width > 0, imageSize.height > 0, bounds.width > 0, bounds.height > 0 else { return bounds }
+        let scale = min(bounds.width / imageSize.width, bounds.height / imageSize.height)
+        let size = CGSize(width: imageSize.width * scale, height: imageSize.height * scale)
+        return CGRect(x: bounds.midX - size.width / 2, y: bounds.midY - size.height / 2,
+                      width: size.width, height: size.height)
+    }
+}
+
+/// iOS 27 delivers the external scene only to this accessory. Earlier iOS
+/// uses ExternalDisplaySceneDelegate from the scene manifest instead.
+struct ExternalDisplayAccessory: ViewModifier {
+    func body(content: Content) -> some View {
+#if CRATE_HAS_IOS27_SDK
+        if #available(iOS 27.0, *) {
+            content.sceneAccessory {
+                ExternalNonInteractiveAccessory {
+                    ExternalDesktopAccessory()
+                }
+            }
+        } else {
+            content
+        }
+#else
+        content
+#endif
+    }
+}
+
+#if CRATE_HAS_IOS27_SDK
+@available(iOS 27.0, *)
+private struct ExternalDesktopAccessory: View {
+    var body: some View {
+        Color.black.ignoresSafeArea()
+    }
+}
+#endif
diff --git a/Sources/Crate/Engine/GuestKeyboard.swift b/Sources/Crate/Engine/GuestKeyboard.swift
new file mode 100644
index 0000000..2ab590f
--- /dev/null
+++ b/Sources/Crate/Engine/GuestKeyboard.swift
@@ -0,0 +1,165 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+import SwiftUI
+import UIKit
+
+/// Keeps a first responder for a hardware keyboard, and can raise iOS's
+/// keyboard with the extra-key row above it, sending Linux key codes to the
+/// virtio keyboard. Used on the VM's screen and on the phone's trackpad
+/// while the desktop is on a monitor, so a keyboard stays with the session.
+struct GuestKeyboard: UIViewRepresentable {
+    let bridge: DisplayBridge
+    @Binding var showsKeyboard: Bool
+
+    func makeUIView(context: Context) -> Catcher {
+        let view = Catcher(bridge: bridge)
+        view.onKeyboardHidden = { showsKeyboard = false }
+        return view
+    }
+
+    func updateUIView(_ view: Catcher, context: Context) {
+        view.bridge = bridge
+        if showsKeyboard, !view.isFirstResponder {
+            view.becomeFirstResponder()
+        } else if !showsKeyboard {
+            if view.isFirstResponder { _ = view.resignFirstResponder() }
+            view.takeHardwareKeys()
+        }
+    }
+
+    final class Catcher: UIView, UIKeyInput {
+        var bridge: DisplayBridge
+        var onKeyboardHidden: (() -> Void)?
+        private let hardware = HardwareCatcher()
+        private var latchedForPress: [UInt16] = []
+
+        init(bridge: DisplayBridge) {
+            self.bridge = bridge
+            super.init(frame: .zero)
+            backgroundColor = .clear
+            isUserInteractionEnabled = false
+            hardware.owner = self
+            addSubview(hardware)
+        }
+
+        @available(*, unavailable)
+        required init?(coder: NSCoder) { fatalError() }
+
+        override var canBecomeFirstResponder: Bool { true }
+
+        func takeHardwareKeys() {
+            guard window != nil, !isFirstResponder, !hardware.isFirstResponder else { return }
+            hardware.becomeFirstResponder()
+        }
+
+        override func didMoveToWindow() {
+            super.didMoveToWindow()
+            takeHardwareKeys()
+        }
+
+        private lazy var keyBar: DisplayKeyBar = {
+            let bar = DisplayKeyBar()
+            bar.onKey = { [weak self] code, down in self?.bridge.key(code, down: down) }
+            bar.onDismiss = { [weak self] in _ = self?.resignFirstResponder() }
+            return bar
+        }()
+
+        override var inputAccessoryView: UIView? { keyBar }
+
+        override func resignFirstResponder() -> Bool {
+            keyBar.releaseAll()
+            let resigned = super.resignFirstResponder()
+            if resigned { onKeyboardHidden?() }
+            return resigned
+        }
+
+        var hasText: Bool { true }
+
+        func insertText(_ text: String) {
+            withLatchedModifiers {
+                for character in text {
+                    guard let stroke = LinuxKeys.stroke(for: character) else { continue }
+                    if stroke.shift { bridge.key(LinuxKeys.leftShift, down: true) }
+                    bridge.key(stroke.code, down: true)
+                    bridge.key(stroke.code, down: false)
+                    if stroke.shift { bridge.key(LinuxKeys.leftShift, down: false) }
+                }
+            }
+        }
+
+        func deleteBackward() {
+            withLatchedModifiers {
+                bridge.key(14, down: true)
+                bridge.key(14, down: false)
+            }
+        }
+
+        private func withLatchedModifiers(_ keystroke: () -> Void) {
+            let modifiers = keyBar.takeModifiers()
+            for code in modifiers { bridge.key(code, down: true) }
+            keystroke()
+            for code in modifiers.reversed() { bridge.key(code, down: false) }
+        }
+
+        var autocorrectionType: UITextAutocorrectionType = .no
+        var autocapitalizationType: UITextAutocapitalizationType = .none
+        var spellCheckingType: UITextSpellCheckingType = .no
+        var smartQuotesType: UITextSmartQuotesType = .no
+        var smartDashesType: UITextSmartDashesType = .no
+        var smartInsertDeleteType: UITextSmartInsertDeleteType = .no
+        var keyboardType: UIKeyboardType = .asciiCapable
+
+        override func pressesBegan(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+            if !forward(presses, down: true) { super.pressesBegan(presses, with: event) }
+        }
+
+        override func pressesEnded(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+            if !forward(presses, down: false) { super.pressesEnded(presses, with: event) }
+        }
+
+        override func pressesCancelled(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+            if !forward(presses, down: false) { super.pressesCancelled(presses, with: event) }
+        }
+
+        private func forward(_ presses: Set<UIPress>, with event: UIPressesEvent? = nil, down: Bool) -> Bool {
+            var handled = false
+            for press in presses {
+                guard let key = press.key, let code = LinuxKeys.code(for: key.keyCode) else { continue }
+                let isModifier = LinuxKeys.modifiers.contains(code)
+                if down, !isModifier {
+                    latchedForPress = keyBar.takeModifiers()
+                    for modifier in latchedForPress { bridge.key(modifier, down: true) }
+                }
+                bridge.key(code, down: down)
+                if !down, !isModifier {
+                    for modifier in latchedForPress.reversed() { bridge.key(modifier, down: false) }
+                    latchedForPress = []
+                }
+                handled = true
+            }
+            return handled
+        }
+    }
+
+    /// A first responder that isn't text input, so it brings up no keyboard.
+    final class HardwareCatcher: UIView {
+        weak var owner: Catcher?
+
+        override var canBecomeFirstResponder: Bool { true }
+        override var next: UIResponder? { owner?.next }
+
+        override func pressesBegan(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+            owner?.pressesBegan(presses, with: event)
+        }
+
+        override func pressesEnded(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+            owner?.pressesEnded(presses, with: event)
+        }
+
+        override func pressesCancelled(_ presses: Set<UIPress>, with event: UIPressesEvent?) {
+            owner?.pressesCancelled(presses, with: event)
+        }
+    }
+}
diff --git a/Sources/Crate/Engine/GuestPointer.swift b/Sources/Crate/Engine/GuestPointer.swift
new file mode 100644
index 0000000..bac3cc8
--- /dev/null
+++ b/Sources/Crate/Engine/GuestPointer.swift
@@ -0,0 +1,58 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+import Foundation
+
+/// The guest's one tablet pointer: crate's virtio-input tablet is absolute
+/// (0...1 across the desktop), so a mouse, a trackpad and the on-screen
+/// tablet all share this position. Relative motion is accumulated here and
+/// sent as an absolute point.
+@MainActor
+final class GuestPointer {
+    private let bridge: DisplayBridge
+    /// Across the desktop, 0 to 1.
+    private(set) var x = 0.5
+    private(set) var y = 0.5
+    private(set) var buttons: UInt32 = 0
+
+    init(bridge: DisplayBridge) {
+        self.bridge = bridge
+    }
+
+    /// Moves by `dx` and `dy` guest pixels (down is positive).
+    func move(dx: Double, dy: Double) {
+        let size = bridge.size
+        let width = max(size.width, 1)
+        let height = max(size.height, 1)
+        x = min(1, max(0, x + dx / width))
+        y = min(1, max(0, y + dy / height))
+        bridge.pointer(x: x, y: y, buttons: buttons)
+    }
+
+    func setButtons(_ buttons: UInt32) {
+        self.buttons = buttons
+        bridge.pointer(x: x, y: y, buttons: buttons)
+    }
+
+    func press(_ bit: UInt32, down: Bool) {
+        if down { buttons |= bit } else { buttons &= ~bit }
+        bridge.pointer(x: x, y: y, buttons: buttons)
+    }
+
+    /// A brief press of one button (bit 1 left, bit 2 right, bit 4 middle).
+    func click(_ bit: UInt32) {
+        press(bit, down: true)
+        press(bit, down: false)
+    }
+
+    func scroll(dx: Int32, dy: Int32) {
+        guard dx != 0 || dy != 0 else { return }
+        bridge.scroll(dx: dx, dy: dy)
+    }
+
+    func releaseAll() {
+        guard buttons != 0 else { return }
+        setButtons(0)
+    }
+}
diff --git a/Sources/Crate/Engine/HardwareMouse.swift b/Sources/Crate/Engine/HardwareMouse.swift
new file mode 100644
index 0000000..0e2d219
--- /dev/null
+++ b/Sources/Crate/Engine/HardwareMouse.swift
@@ -0,0 +1,127 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+import Foundation
+import GameController
+import UIKit
+
+/// A USB or Bluetooth mouse (or a Magic Keyboard's trackpad), while a VM is
+/// running. GameController gives movement, buttons and the wheel; those
+/// become the guest's tablet pointer and scroll wheel. Pointer lock is
+/// requested so iPadOS hides its own cursor (an iPhone does not lock it).
+@MainActor
+final class HardwareMouse {
+    static let shared = HardwareMouse()
+
+    private var mice: [GCMouse] = []
+    private var observers: [NSObjectProtocol] = []
+    private weak var pointer: GuestPointer?
+    private var leftoverX: Double = 0
+    private var leftoverY: Double = 0
+    private var lastScrollVertical: Float = 0
+    private var lastScrollHorizontal: Float = 0
+
+    func start(pointer: GuestPointer) {
+        stop()
+        self.pointer = pointer
+        leftoverX = 0
+        leftoverY = 0
+        lastScrollVertical = 0
+        lastScrollHorizontal = 0
+        GCMouse.mice().forEach(attach)
+        let center = NotificationCenter.default
+        observers.append(center.addObserver(forName: .GCMouseDidConnect, object: nil, queue: .main) { [weak self] note in
+            Task { @MainActor in
+                if let mouse = note.object as? GCMouse { self?.attach(mouse) }
+            }
+        })
+        observers.append(center.addObserver(forName: .GCMouseDidDisconnect, object: nil, queue: .main) { [weak self] note in
+            Task { @MainActor in
+                guard let self, let mouse = note.object as? GCMouse else { return }
+                self.pointer?.releaseAll()
+                self.mice.removeAll { $0 === mouse }
+                AppLog.write("mouse: disconnected")
+                PointerLock.set(wanted: !self.mice.isEmpty)
+            }
+        })
+        observers.append(center.addObserver(forName: UIPointerLockState.didChangeNotification, object: nil, queue: .main) { note in
+            let scene = note.userInfo?[UIPointerLockState.sceneUserInfoKey] as? UIScene
+            let locked = scene?.pointerLockState?.isLocked ?? false
+            AppLog.write("pointer lock: \(locked ? "on" : "off")")
+        })
+        PointerLock.set(wanted: !mice.isEmpty)
+    }
+
+    func stop() {
+        PointerLock.set(wanted: false)
+        pointer?.releaseAll()
+        observers.forEach(NotificationCenter.default.removeObserver)
+        observers.removeAll()
+        for mouse in mice {
+            guard let input = mouse.mouseInput else { continue }
+            input.mouseMovedHandler = nil
+            input.leftButton.pressedChangedHandler = nil
+            input.rightButton?.pressedChangedHandler = nil
+            input.middleButton?.pressedChangedHandler = nil
+            input.scroll.valueChangedHandler = nil
+        }
+        mice.removeAll()
+        pointer = nil
+    }
+
+    private func attach(_ mouse: GCMouse) {
+        guard let input = mouse.mouseInput, !mice.contains(where: { $0 === mouse }) else { return }
+        mice.append(mouse)
+        AppLog.write("mouse: \(mouse.vendorName ?? "unknown"), right \(input.rightButton != nil), middle \(input.middleButton != nil)")
+        input.mouseMovedHandler = { [weak self] _, dx, dy in
+            Task { @MainActor in self?.moved(dx, dy) }
+        }
+        input.leftButton.pressedChangedHandler = { [weak self] _, _, down in
+            Task { @MainActor in self?.pointer?.press(1, down: down) }
+        }
+        input.rightButton?.pressedChangedHandler = { [weak self] _, _, down in
+            Task { @MainActor in self?.pointer?.press(2, down: down) }
+        }
+        input.middleButton?.pressedChangedHandler = { [weak self] _, _, down in
+            Task { @MainActor in self?.pointer?.press(4, down: down) }
+        }
+        input.scroll.valueChangedHandler = { [weak self] _, first, second in
+            Task { @MainActor in self?.scrolled(vertical: first, horizontal: second) }
+        }
+        PointerLock.set(wanted: true)
+    }
+
+    /// GameController's Y runs upward. Whole guest pixels are sent; fractions
+    /// wait for the next move.
+    private func moved(_ dx: Float, _ dy: Float) {
+        leftoverX += Double(dx)
+        leftoverY -= Double(dy)
+        let stepX = leftoverX.rounded(.towardZero)
+        let stepY = leftoverY.rounded(.towardZero)
+        guard stepX != 0 || stepY != 0 else { return }
+        leftoverX -= stepX
+        leftoverY -= stepY
+        pointer?.move(dx: stepX, dy: stepY)
+    }
+
+    /// Vertical motion arrives on the first axis, horizontal on the second.
+    /// Only an axis that changed is sent, so a device that reports both
+    /// values together does not double the scroll or drift sideways.
+    private func scrolled(vertical: Float, horizontal: Float) {
+        let verticalChanged = vertical != lastScrollVertical
+        let horizontalChanged = horizontal != lastScrollHorizontal
+        lastScrollVertical = vertical
+        lastScrollHorizontal = horizontal
+        let dy = verticalChanged ? notches(vertical) : 0
+        let dx = horizontalChanged ? notches(horizontal) : 0
+        // crate: positive dy scrolls down.
+        pointer?.scroll(dx: dx, dy: -dy)
+    }
+
+    private func notches(_ value: Float) -> Int32 {
+        guard value.isFinite, value != 0 else { return 0 }
+        let units = Int32(min(12, max(1, (abs(value) * 2).rounded())))
+        return value < 0 ? -units : units
+    }
+}
