+
+/// The monitor as the coordinator sees it when iOS 27 hands crate a scene
+/// accessory instead of a UIKit scene: the same picture view, at the
+/// accessory's own size times its screen's scale.
+final class AccessoryScreenView: UIView, ExternalScreen {
+    let id = UUID()
+    private let outputID = UUID()
+    private var attached = false
+    private var lastPixels = CGSize.zero
+    private var picture: ExternalScreenView?
+    private let idle = UILabel()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        backgroundColor = .black
+        isUserInteractionEnabled = false
+        idle.text = "Start a machine to show the desktop here."
+        idle.textColor = .lightGray
+        idle.font = .preferredFont(forTextStyle: .title2)
+        idle.textAlignment = .center
+        idle.numberOfLines = 0
+        idle.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(idle)
+        NSLayoutConstraint.activate([
+            idle.centerXAnchor.constraint(equalTo: centerXAnchor),
+            idle.centerYAnchor.constraint(equalTo: centerYAnchor),
+            idle.leadingAnchor.constraint(greaterThanOrEqualTo: leadingAnchor, constant: 40),
+            idle.trailingAnchor.constraint(lessThanOrEqualTo: trailingAnchor, constant: -40),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) { fatalError() }
+
+    var nativePixels: CGSize {
+        let scale = max(window?.windowScene?.screen.scale ?? traitCollection.displayScale, 1)
+        return CGSize(width: bounds.width * scale, height: bounds.height * scale)
+    }
+
+    override func didMoveToWindow() {
+        super.didMoveToWindow()
+        if window == nil { detach() } else { setNeedsLayout() }
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        let pixels = nativePixels
+        guard window != nil, pixels.width >= 16, pixels.height >= 16 else { return }
+        if !attached {
+            attached = true
+            lastPixels = pixels
+            logGeometry()
+            ExternalDisplayCoordinator.shared.attach(self)
+        } else if pixels != lastPixels {
+            lastPixels = pixels
+            logGeometry()
+            ExternalDisplayCoordinator.shared.screenDidChangeSize(self)
+        }
+    }
+
+    func detach() {
+        guard attached else { return }
+        attached = false
+        ExternalDisplayCoordinator.shared.detach(self)
+    }
+
+    private func logGeometry() {
+        let size = { (s: CGSize) in "\(Int(s.width))x\(Int(s.height))" }
+        let screen = window?.windowScene?.screen
+        AppLog.write("external display: accessory \(size(bounds.size)) pt, offered \(size(nativePixels)) px, "
+                     + "mode \(screen?.currentMode.map { size($0.size) } ?? "unknown"), "
+                     + "native \(screen.map { size($0.nativeBounds.size) } ?? "unknown")")
+    }
+
+    func showDesktop(bridge: DisplayBridge) {
+        picture?.removeFromSuperview()
+        let view = ExternalScreenView(bridge: bridge, outputID: outputID)
+        view.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(view)
+        NSLayoutConstraint.activate([
+            view.leadingAnchor.constraint(equalTo: leadingAnchor),
+            view.trailingAnchor.constraint(equalTo: trailingAnchor),
+            view.topAnchor.constraint(equalTo: topAnchor),
+            view.bottomAnchor.constraint(equalTo: bottomAnchor),
+        ])
+        picture = view
+        idle.isHidden = true
+    }
+
+    func hideDesktop() {
+        picture?.removeFromSuperview()
+        picture = nil
+        idle.isHidden = false
+    }
+}
