import("//build/config/ios/rules.gni")
import("//build/config/ui.gni")

# Milestone 1 host: a Views widget on the iOS Simulator.
ios_app_bundle("views_examples_ios") {
  testonly = true
  info_plist = "Info.plist"
  sources = [ "views_examples_ios_main.mm" ]
  bundle_identifier = "com.davidhope.deskbrowser.views"

  deps = [
    "//base",
    "//base:i18n",
    "//mojo/core/embedder",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/color:mixers",
    "//ui/compositor",
    "//ui/compositor:test_support",
    "//ui/display",
    "//ui/gfx",
    "//ui/gl",
    "//ui/gl/init",
    "//ui/views",
  ]

  frameworks = [
    "UIKit.framework",
    "Foundation.framework",
    "QuartzCore.framework",
  ]
}
