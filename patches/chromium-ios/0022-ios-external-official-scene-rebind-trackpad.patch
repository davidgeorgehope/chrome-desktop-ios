+- (void)deskBrowserInjectMouseAtViewPoint:(CGPoint)point
+                                     type:(NSInteger)type
+                                   button:(NSInteger)button {
+  if (!_view || !_view->host()) {
+    return;
+  }
+  blink::WebInputEvent::Type web_type =
+      type == 1   ? blink::WebInputEvent::Type::kMouseDown
+      : type == 2 ? blink::WebInputEvent::Type::kMouseUp
+                  : blink::WebInputEvent::Type::kMouseMove;
+  blink::WebPointerProperties::Button web_button =
+      (web_type == blink::WebInputEvent::Type::kMouseMove && button == 0)
+          ? blink::WebPointerProperties::Button::kNoButton
+          : blink::WebPointerProperties::Button::kLeft;
+  int modifiers = 0;
+  if (web_type == blink::WebInputEvent::Type::kMouseDown ||
+      (web_type == blink::WebInputEvent::Type::kMouseMove && button != 0)) {
+    modifiers |= blink::WebInputEvent::kLeftButtonDown;
+  }
+  const int click_count =
+      (web_type == blink::WebInputEvent::Type::kMouseDown ||
+       web_type == blink::WebInputEvent::Type::kMouseUp)
+          ? 1
+          : 0;
+  gfx::PointF pos(point.x, point.y);
+  blink::WebMouseEvent event(web_type, pos, pos, web_button, click_count,
+                             modifiers, base::TimeTicks::Now());
+  _view->InjectMouseEvent(event, ui::LatencyInfo());
+}
+
+- (void)deskBrowserInjectWheelAtViewPoint:(CGPoint)point
+                                    delta:(CGPoint)delta
+                                    phase:(NSInteger)phase {
+  if (!_view || !_view->host()) {
+    return;
+  }
+  blink::WebMouseWheelEvent event(blink::WebInputEvent::Type::kMouseWheel, 0,
+                                  base::TimeTicks::Now());
+  gfx::PointF pos(point.x, point.y);
+  event.SetPositionInWidget(pos);
+  event.SetPositionInScreen(pos);
+  // Chrome wheel deltas are positive up/left.
+  event.delta_x = delta.x;
+  event.delta_y = delta.y;
+  event.wheel_ticks_x = delta.x / 120.f;
+  event.wheel_ticks_y = delta.y / 120.f;
+  if (phase == 0) {
+    event.phase = blink::WebMouseWheelEvent::kPhaseBegan;
+  } else if (phase == 2) {
+    event.phase = blink::WebMouseWheelEvent::kPhaseEnded;
+  } else {
+    event.phase = blink::WebMouseWheelEvent::kPhaseChanged;
+  }
+  event.event_action = blink::WebMouseWheelEvent::EventAction::kScroll;
+  _view->InjectMouseWheelEvent(event, ui::LatencyInfo());
+}
+
+
 @end
