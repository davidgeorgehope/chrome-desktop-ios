import("//build/config/ui.gni")

# Centralized target for enterprise net components.
group("net") {
  public_deps = [ "//components/enterprise/net/core" ]
  if (!(is_ios && !enable_ios_desktop_views)) {
    public_deps += [ "//components/enterprise/net/content" ]
  }
}
