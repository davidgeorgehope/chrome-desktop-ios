import("//chrome/common/features.gni")
import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions_core)
assert(is_chromeos)

source_set("enterprise_platform_keys") {
  sources = [
    "enterprise_platform_keys_api.cc",
    "enterprise_platform_keys_api.h",
  ]

  public_deps = [
    "//build:chromeos_buildflags",
  ]

  deps = [
    "//base",
    "//chrome/browser/ash/platform_keys",
    "//chrome/browser/ash/platform_keys:keystore_service",
    "//chrome/browser/profiles:profile",
    "//chrome/common/extensions/api",
    "//chromeos/ash/components/platform_keys",
  ]
  if (enable_extensions_core) {
    public_deps += [ "//extensions/browser" ]
  }
  if (enable_extensions_core) {
    deps += [ "//chrome/browser/extensions" ]
  }
}

source_set("enterprise_platform_keys_registry_util") {
  sources = [
    "enterprise_platform_keys_registry_util.cc",
    "enterprise_platform_keys_registry_util.h",
  ]

  deps = [
    "//base",
    "//chrome/common:constants",
    "//components/pref_registry",
  ]
}
