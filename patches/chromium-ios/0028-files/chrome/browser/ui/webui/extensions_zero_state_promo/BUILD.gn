import("//mojo/public/tools/bindings/mojom.gni")
import("//extensions/buildflags/buildflags.gni")

mojom("mojo_bindings") {
  sources = [ "zero_state_promo.mojom" ]
  webui_module_path = "/"
  public_deps = [
    "//mojo/public/mojom/base",
    "//ui/base/mojom",
  ]
}

source_set("extensions_zero_state_promo") {
  sources = [
    "zero_state_promo_page_handler.cc",
    "zero_state_promo_ui.cc",
  ]
  public = [
    "zero_state_promo_page_handler.h",
    "zero_state_promo_ui.h",
  ]

  deps = [
    ":mojo_bindings",
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/views/user_education",
    "//chrome/browser/ui/webui:theme_source",
    "//chrome/browser/ui/webui/top_chrome",
    "//chrome/common",
    "//components/feature_engagement/public",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/base",
    "//ui/views",
    "//ui/webui",
    "//url",
  ]
  if (enable_extensions_core) {
    deps += [ "//extensions/common" ]
  }
  if (enable_extensions) {
    deps += [ "//chrome/browser/resources/extensions_zero_state_promo:resources" ]
  }
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "zero_state_promo_page_handler_browsertest.cc" ]
  deps = [
    ":extensions_zero_state_promo",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//components/feature_engagement/public",
    "//components/feature_engagement/test:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//url",
  ]
  if (enable_extensions_core) {
    deps += [ "//extensions/common" ]
  }
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "extensions_zero_state_promo_interactive_uitest.cc" ]
  deps = [
    ":extensions_zero_state_promo",
    ":mojo_bindings",
    "//base/test:test_support",
    "//chrome/browser/ui/views/user_education:impl",
    "//chrome/common",
    "//chrome/test:test_support",
    "//chrome/test/user_education:impl",
    "//components/user_education/common",
    "//components/user_education/views",
    "//content/test:test_support",
    "//url",
  ]
  if (enable_extensions_core) {
    deps += [
      "//chrome/browser/ui/views/extensions:extensions_toolbar_desktop",
      "//extensions/common",
    ]
  }
}
