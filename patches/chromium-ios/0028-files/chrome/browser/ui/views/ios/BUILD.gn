import("//build/config/ios/rules.gni")
import("//build/config/ui.gni")

# Probe + host for the real desktop BrowserView on iOS. Only reachable
# when enable_ios_desktop_views is set; the device IPA leaves the flag
# off and does not depend on these targets.
assert(is_ios && enable_ios_desktop_views)

# Forces the //chrome/browser/ui/views/frame:browser_view graph to load
# under an iOS gn gen so we can walk and widen asserts.
group("browser_view_ios") {
  deps = [ "//chrome/browser/ui/views/frame:browser_view" ]
}
