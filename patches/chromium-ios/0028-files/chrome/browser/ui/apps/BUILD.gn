import("//printing/buildflags/buildflags.gni")
import("//extensions/buildflags/buildflags.gni")
import("//build/config/ui.gni")

assert(is_win || is_mac || is_linux || is_chromeos || (is_ios && enable_ios_desktop_views))

source_set("apps") {
  sources = [
    "chrome_app_delegate.h",
    "chrome_app_window_client.h",
    "directory_access_confirmation_dialog.h",
  ]

  public_deps = [
    "//base",
    "//ui/base:types",
    "//ui/gfx/geometry",
  ]
  if (enable_extensions_core) {
    public_deps += [ "//extensions/browser" ]
  }
}

source_set("impl") {
  sources = [
    "chrome_app_delegate.cc",
    "chrome_app_window_client.cc",
    "directory_access_confirmation_dialog.cc",
  ]

  deps = [
    ":apps",
    "//chrome/app:generated_resources",
    "//chrome/app:generated_resources_grit",
    "//chrome/browser:file_select_helper",
    "//chrome/browser:primitives",
    "//chrome/browser:shell_integration",
    "//chrome/browser/app_mode",
    "//chrome/browser/devtools",
    "//chrome/browser/favicon",
    "//chrome/browser/file_system_access",
    "//chrome/browser/lifetime:termination_notification",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/ui:browser_tabstrip",
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser/ui:scoped_tabbed_browser_displayer",
    "//chrome/browser/ui:tab_modal_confirm_dialog",
    "//chrome/browser/ui:tab_modal_confirm_dialog_delegate",
    "//chrome/browser/ui/navigator",
    "//components/keep_alive_registry",
    "//components/version_info",
    "//components/zoom",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//printing/buildflags",
    "//services/service_manager/public/cpp",
    "//ui/base",
  ]

  if (is_chromeos) {
    deps += [ "//chrome/browser/chromeos/policy/dlp" ]
  }
  if (enable_printing) {
    deps += [ "//chrome/browser/printing" ]
  }
  if (enable_extensions_core) {
    deps += [
      "//extensions/common",
      "//extensions/common:common_constants",
      "//extensions/common:mojom",
    ]
  }
  if (enable_platform_apps) {
    deps += [ "//chrome/browser/apps/platform_apps" ]
  }
}
