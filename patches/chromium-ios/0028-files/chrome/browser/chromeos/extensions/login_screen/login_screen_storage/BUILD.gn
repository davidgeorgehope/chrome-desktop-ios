import("//extensions/buildflags/buildflags.gni")

assert(enable_extensions)
assert(is_chromeos)

static_library("login_screen_storage") {
  sources = [
    "login_screen_storage_api.cc",
    "login_screen_storage_api.h",
  ]

  public_deps = [
    "//chromeos/ash/components/dbus/session_manager:login_manager_proto",
  ]

  deps = [
    "//base",
    "//chromeos/ash/components/dbus/session_manager",
    "//chromeos/ash/experiences/extensions/common/api",
  ]
  if (enable_extensions_core) {
    public_deps += [ "//extensions/browser" ]
  }
}

source_set("browser_tests") {
  testonly = true

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "login_screen_storage_apitest.cc" ]

  deps = [
    "//base",
    "//chrome/browser/policy:extension_force_install_mixin",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//components/policy/core/browser",
    "//components/policy/core/common:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
  if (enable_extensions_core) {
    deps += [ "//extensions:test_support" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [ "login_screen_storage_api_ash_unittest.cc" ]

  deps = [
    ":login_screen_storage",
    "//base",
    "//chrome/test:test_support",
    "//chromeos/ash/components/dbus/session_manager",
    "//testing/gmock",
    "//testing/gtest",
  ]
  if (enable_extensions_core) {
    deps += [
      "//extensions:test_support",
      "//extensions/common",
    ]
  }
}
