+
+- (void)startAvailableMemoryPolling {
+  if (_availableMemoryTimer) {
+    return;
+  }
+  dispatch_source_t timer = dispatch_source_create(
+      DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+  const uint64_t interval_ns =
+      (uint64_t)(kAvailableMemoryPollInterval * NSEC_PER_SEC);
+  dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, interval_ns),
+                            interval_ns, interval_ns / 5);
+  __weak MemoryWarningHelper* weakSelf = self;
+  dispatch_source_set_event_handler(timer, ^{
+    [weakSelf pollAvailableMemory];
+  });
+  dispatch_resume(timer);
+  _availableMemoryTimer = timer;
+}
+
+- (void)pollAvailableMemory {
+  const size_t available = os_proc_available_memory();
+  base::MemoryPressureLevel level = base::MEMORY_PRESSURE_LEVEL_NONE;
+  if (available < kCriticalAvailableBytes) {
+    level = base::MEMORY_PRESSURE_LEVEL_CRITICAL;
+  } else if (available < kModerateAvailableBytes) {
+    level = base::MEMORY_PRESSURE_LEVEL_MODERATE;
+  }
+  const CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+  const bool level_changed = level != _lastPolledLevel;
+  const bool renotify_critical =
+      level == base::MEMORY_PRESSURE_LEVEL_CRITICAL &&
+      (now - _lastCriticalNotifyTime) >= kCriticalRenotifyInterval;
+  _lastPolledLevel = level;
+  if (level == base::MEMORY_PRESSURE_LEVEL_NONE) {
+    return;
+  }
+  DeskBrowserEnforceLiveTabCap();
+  if (level_changed || renotify_critical) {
+    base::MemoryPressureListener::NotifyMemoryPressure(level);
+    if (level == base::MEMORY_PRESSURE_LEVEL_CRITICAL) {
+      _lastCriticalNotifyTime = now;
+    }
+  }
+}
