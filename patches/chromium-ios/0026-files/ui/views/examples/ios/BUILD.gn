import("//build/config/ios/rules.gni")
import("//build/config/ui.gni")

# Milestone 2 host: a desktop-style Views chrome (tab strip + toolbar)
# on the iOS Simulator, behind enable_ios_desktop_views.
ios_app_bundle("views_examples_ios") {
  testonly = true
  info_plist = "Info.plist"
  sources = [
    "desktop_browser_chrome_view.h",
    "desktop_browser_chrome_view.mm",
    "views_examples_ios_main.mm",
  ]
  bundle_identifier = "com.davidhope.deskbrowser.views"

  deps = [
    "//ui/accessibility:test_support",
    "//base",
    "//base:i18n",
    "//mojo/core/embedder",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/color:mixers",
    "//ui/compositor",
    "//ui/compositor:test_support",
    "//ui/display",
    "//ui/gfx",
    "//ui/gl",
    "//ui/gl/init",
    "//ui/views",
    "//ui/resources:ui_test_pak_bundle_data",
  ]

  frameworks = [
    "UIKit.framework",
    "Foundation.framework",
    "QuartzCore.framework",
  ]
}
