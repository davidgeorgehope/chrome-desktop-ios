import("//build/config/ui.gni")
import("//extensions/buildflags/buildflags.gni")

assert(use_aura)

source_set("accessibility") {
  sources = [ "automation_manager_aura.h" ]

  public_deps = [
    "//base",
    "//ui/accessibility",
    "//ui/views",
  ]
  if (enable_extensions_core) {
    public_deps += [ "//extensions/browser/api" ]
  }
}

source_set("impl") {
  sources = [ "automation_manager_aura.cc" ]

  deps = [
    ":accessibility",
    "//base",
    "//ui/accessibility",
    "//ui/aura",
    "//ui/display",
    "//ui/views",
    "//ui/wm",
    "//ui/wm/public",
  ]
  if (enable_extensions_core) {
    deps += [ "//extensions/browser/api" ]
  }
}

source_set("interactive_ui_tests") {
  testonly = true

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "automation_manager_aura_browsertest.cc" ]

  deps = [
    "//base",
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser/ui/aura/accessibility",
    "//content/public/browser",
    "//content/test:test_support",
    "//ui/accessibility",
    "//ui/base",
    "//ui/gfx/geometry",
    "//ui/views",
    "//ui/views:test_support",
  ]
  if (enable_extensions_core) {
    deps += [ "//extensions/browser/api/automation_internal" ]
  }
  if (!is_ios) {
    deps += [ "//chrome/test:test_support" ]
  }
}
