     base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
     // deskbrowser: always desktop mode (no mobile viewport / mobile UA).
     (void)command_line;
+
+#if !BUILDFLAG(IS_IOS_TVOS) && !TARGET_OS_SIMULATOR
+    // deskbrowser device build: BrowserEngineKit child processes need
+    // web-browser-engine entitlements we do not have, so a home-screen launch
+    // must default to single-process Blink with in-process GPU. The
+    // NetTaskScheduler features must be off in single-process (see
+    // run-chrome-ios-blink-sim.sh).
+    if (!command_line->HasSwitch(switches::kSingleProcess)) {
+      command_line->AppendSwitch(switches::kSingleProcess);
+    }
+    if (!command_line->HasSwitch(switches::kInProcessGPU)) {
+      command_line->AppendSwitch(switches::kInProcessGPU);
+    }
+    {
+      std::string disabled =
+          command_line->GetSwitchValueASCII(switches::kDisableFeatures);
+      if (!disabled.empty()) {
+        disabled += ",";
+      }
+      disabled += "NetTaskScheduler,NetworkServiceTaskScheduler";
+      command_line->AppendSwitchASCII(switches::kDisableFeatures, disabled);
+    }
+    // No JIT entitlement outside BrowserEngineKit processes: run V8 jitless
+    // unless the caller already passed --js-flags.
+    if (!command_line->HasSwitch("js-flags")) {
+      command_line->AppendSwitchASCII("js-flags",
+                                      "--jitless");
+    }
+#endif
 
