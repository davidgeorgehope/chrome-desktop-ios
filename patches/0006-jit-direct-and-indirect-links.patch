+/* The A64 counterpart: one direct-mapped table per executor behind every
+ * A64 indirect site's two cells, so a polymorphic BR/BLR/RET site (a RET
+ * shared by many callers, an interpreter's dispatch) keeps its chain in
+ * generated code. An entry's key is the target's translation key (PC and
+ * mode bits); generated code sends a target with any of bits 48-63 set to
+ * the executor, so only an A64 PC below 2^48 can match, and an empty entry
+ * (key 0, PC 0 in mode 0) is never trained. A matching entry is used only
+ * when its record's activation epoch is the chain's link epoch: a record is
+ * activated only for its own address space's translation of its PC, so an
+ * entry trained in another context, or before a code change, never runs. */
+inline constexpr std::size_t jit_a64_indirect_target_bits = 13;
+inline constexpr std::size_t jit_a64_indirect_target_count =
+    std::size_t{1} << jit_a64_indirect_target_bits;
+
+[[nodiscard]] constexpr std::size_t
+jit_a64_indirect_target_index(std::uint64_t pc) noexcept {
+  return static_cast<std::size_t>(((pc ^ (pc >> 14)) >> 2) &
+                                  (jit_a64_indirect_target_count - 1U));
+}
